__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Hugging Face / dataset / model caches (this project's default cache lives
# outside the repo, in the user's home directory -- these rules are
# defensive in case a cache is ever created locally instead).
.cache/
**/.cache/
huggingface_cache/

# Downloaded/raw dataset files -- this project loads XL-Sum directly from the
# Hub's Parquet revision at run time (src/data/xlsum_loader.py) and never
# writes a local copy, but excluded defensively in case that ever changes.
data/raw/
*.parquet

# Model weights / training checkpoints -- LoRA adapters and any full model
# checkpoints are regenerable via scripts/train_lora.py and must never be
# committed. Matches results/checkpoints/ at any depth.
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
checkpoints/
wandb/

# Large, regenerable raw prediction dumps (full source articles duplicated
# across every row -- tens of MB). Rerun scripts/run_baseline_zero_shot.py /
# scripts/run_lead_n_baseline.py to regenerate. The small, curated
# results/qualitative_samples/representative_examples.csv is intentionally
# NOT excluded -- that one is a real deliverable.
results/qualitative_samples/*_predictions.csv

# Secrets / credentials -- defensive; none currently exist in this repo.
.env
.env.*
*.pem
*.key
*credentials*.json
hf_token*
HF_TOKEN*

# Claude Code local tool state -- machine/session-specific, not project source.
.claude/

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
